NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
RESEND_API_KEY=
# Used to build links inside notification emails. Falls back to
# http://localhost:3000 if unset, so this only matters in production.
NEXT_PUBLIC_SITE_URL=
# Google Analytics 4 measurement ID (format: G-XXXXXXXXXX). Leave unset to
# disable GA entirely — it only loads when this is present.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Sentry DSN for production error monitoring. Leave unset to disable Sentry
# entirely — it's a public identifier, safe to ship to the browser. Get one
# free at sentry.io (new project → Next.js).
NEXT_PUBLIC_SENTRY_DSN=
# Optional: only needed to upload source maps to Sentry at build time, so
# stack traces show real code instead of minified output. Skip these if
# readable prod stack traces in the Sentry dashboard aren't worth the setup
# yet — error capture works fine without them.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
